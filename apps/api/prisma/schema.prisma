// Prisma schema for the Reclo API.
// Docs: https://pris.ly/d/prisma-schema
//
// The connection URL is not set here: Prisma 7 reads it from prisma7.config.ts.
// Models: User (vendor fields: KAN-55), Session (KAN-67), Placement (KAN-23), Inquiry (KAN-35)
// and CartItem (KAN-31).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  VENDOR
  ADMIN
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique // stored trimmed and lowercased
  passwordHash    String
  role            Role        @default(CLIENT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  placements      Placement[]
  sessions        Session[]
  clientInquiries Inquiry[]   @relation("ClientInquiries")
  vendorInquiries Inquiry[]   @relation("VendorInquiries")
  moderationEvents ModerationEvent[] @relation("ModerationEvents")
  cartItems       CartItem[]

  companyName    String?     // set for VENDOR accounts, null otherwise
  createdById     String?     // the ADMIN who created this account; null for self-registered users
  createdBy       User?       @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    User[]      @relation("CreatedUsers")

  // Serves the admin vendor list (KAN-13), newest first.
  @@index([role, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique // SHA-256 hex of the cookie token; the raw token is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PlacementType {
  BILLBOARD
  LED_SCREEN
}

enum PlacementStatus {
  ACTIVE
  PENDING_REVIEW
  INACTIVE
  REJECTED // an admin refused it; the vendor must edit it to resubmit
  ARCHIVED
}

model Placement {
  id            String          @id @default(uuid())
  title         String
  description   String?
  type          PlacementType   @default(BILLBOARD)
  status        PlacementStatus @default(PENDING_REVIEW)
  latitude      Float
  longitude     Float
  address       String
  city          String
  pricePerMonth Int             // Stored as integer in UZS
  width         Float?          // Width in meters
  height        Float?          // Height in meters
  lighting      Boolean         @default(false)
  ledDurationSeconds Int?
  ledPlaysPerDay    Int?
  photos        String[]        @default([])
  archivedAt    DateTime?       // set when status becomes ARCHIVED, cleared on restore
  vendorId      String
  vendor        User            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  inquiries     Inquiry[]
  moderationEvents ModerationEvent[]
  cartItems     CartItem[]
  pricing       PlacementPricing?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([vendorId, status]) // vendor "My listings" list and status filter
  @@index([status, updatedAt]) // moderation queue, oldest first
  @@index([city])
  @@index([latitude, longitude])
}

enum ModerationAction {
  APPROVED
  REJECTED
}

// Append-only audit trail of admin decisions; the app never updates or deletes a row.
model ModerationEvent {
  id          String           @id @default(uuid())
  placementId String
  placement   Placement        @relation(fields: [placementId], references: [id], onDelete: Cascade)
  adminId     String?
  admin       User?            @relation("ModerationEvents", fields: [adminId], references: [id], onDelete: SetNull)
  action      ModerationAction
  reason      String? // required when action = REJECTED, null for APPROVED
  createdAt   DateTime         @default(now())

  // History of one listing, newest first (detail pane, vendor rejection reason).
  @@index([placementId, createdAt])
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

model Inquiry {
  id               String        @id @default(uuid())
  placementId      String
  placement        Placement     @relation(fields: [placementId], references: [id], onDelete: Cascade)
  clientId         String
  client           User          @relation("ClientInquiries", fields: [clientId], references: [id], onDelete: Cascade)
  vendorId         String        // denormalised from placement.vendorId at insert time
  vendor           User          @relation("VendorInquiries", fields: [vendorId], references: [id], onDelete: Cascade)
  status           InquiryStatus @default(NEW)
  message          String
  contactName      String
  contactPhone     String        // E.164, +998XXXXXXXXX
  contactEmail     String
  desiredStartDate DateTime?     // date only; the time component is unused
  durationMonths   Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Serves the client history list (KAN-9), newest-first for one client.
  @@index([clientId, createdAt])
  // Serves the vendor inbox counting unread (KAN-15).
  @@index([vendorId, status])
  @@index([placementId])
}

// A signed-in client's media plan (KAN-7). One row per placement: the primary key is the
// duplicate rule. Title, price and photo are read from Placement, so nothing here goes stale.
model CartItem {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now())

  @@id([userId, placementId]) // also serves "this user's cart"
  @@index([placementId]) // serves the cascade when a placement is deleted
}

// A vendor's term x duration price list (KAN-11). One row per placement. Prices are net, in
// tiyin, row-major (`prices[term][duration]`); see packages/shared/src/pricing.ts.
model PlacementPricing {
  placementId String    @id
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  terms       Int[]
  durations   Int[]
  prices      Json
  vatEnabled  Boolean   @default(false)
  vatRate     Int       @default(1200) // basis points
  updatedAt   DateTime  @updatedAt
}
