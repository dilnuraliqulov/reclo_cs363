# Copy this file to `.env` (same folder). Never commit `.env`.

# Port the API listens on.
PORT=4000

# Local Docker Postgres from docker-compose.yml (development credentials only).
DATABASE_URL="postgresql://reclo:reclo@localhost:5435/reclo?schema=public"

# Origin of the web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Public origin of this API, prefixed onto listing photo paths. Defaults to http://localhost:PORT.
# API_PUBLIC_URL=http://localhost:4000
