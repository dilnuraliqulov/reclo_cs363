# Copy this file to `.env` (same folder). Never commit `.env`.

# Port the API listens on.
PORT=4000

# Local Docker Postgres from docker-compose.yml (development credentials only).
DATABASE_URL="postgresql://reclo:reclo@localhost:5435/reclo?schema=public"

# Origin of the web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Public origin of this API, prefixed onto listing photo paths. Defaults to http://localhost:PORT.
# API_PUBLIC_URL=http://localhost:4000

# Vendor emails on each new inquiry (KAN-17). Mailpit from docker-compose.yml catches them; open
# http://localhost:8026 to read them. Leave SMTP_URL unset to print emails to the console instead.
SMTP_URL=smtp://localhost:1026
# MAIL_FROM="Reclo <no-reply@reclo.uz>"

# Origin of the web app, for links in emails. Defaults to CORS_ORIGIN.
# WEB_PUBLIC_URL=http://localhost:5173

# Only read by `pnpm db:seed-admin` (the first admin account). Set them in the shell, not here, unless
# this is a throwaway local database.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
