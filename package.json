{
  "name": "reclo",
  "version": "0.0.0",
  "private": true,
  "description": "Reclo: a two-sided outdoor advertising marketplace for Uzbekistan",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @reclo/web --filter @reclo/api run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @reclo/api run db:migrate",
    "db:generate": "pnpm --filter @reclo/api run db:generate",
    "db:seed-admin": "pnpm --filter @reclo/api run db:seed-admin",
    "db:studio": "pnpm --filter @reclo/api run db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
